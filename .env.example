ORACLE_SHARED_BROWSER=1
ORACLE_BROWSER_CDP_URL=http://127.0.0.1:9333
ORACLE_BROWSER_LAUNCH_CDP=1
# Both providers use one native Chrome profile and a combined four-Session pool.
# Default: runtime/oracle-browser-profile. Set this to an existing authenticated profile if needed.
# ORACLE_BROWSER_PROFILE_DIR=

CHATGPT_ORACLE_ROOT=D:\\Project\\NEKO\\gpt explorer
CHATGPT_ORACLE_TRANSPORT=stdio
CHATGPT_ORACLE_HOST=127.0.0.1
CHATGPT_ORACLE_PORT=8787
CHATGPT_ORACLE_MCP_PATH=/mcp
# Set the externally reachable origin when clients cannot resolve relative /v2 file paths.
# CHATGPT_ORACLE_PUBLIC_BASE_URL=https://chatgpt-oracle.frp-service.neko-dashboard.com:32751
# Exact Host values accepted by the MCP transport; comma-separated.
CHATGPT_ORACLE_ALLOWED_HOSTS=chatgpt-oracle.frp-service.neko-dashboard.com:32751
# Exact local Tailscale IPs enable Bearer-free direct tailnet requests and add IP Hosts.
# Both local socket destination and remote peer must be Tailscale addresses.
# Public/FRP and loopback requests still require the configured Bearer.
# CHATGPT_ORACLE_TAILSCALE_IPS=100.77.245.1
# Provider-specific profile/CDP options apply only with ORACLE_SHARED_BROWSER=0.
CHATGPT_BROWSER_CDP_URL=http://127.0.0.1:9222
CHATGPT_CHROME_EXECUTABLE=D:\\Program Files\\Google\\Chrome\\Application\\chrome.exe
CHATGPT_BROWSER_LAUNCH_CDP=1
# Maximum count for recent-turn exports; not a source API page limit.
CHATGPT_EXPORT_MAX_COUNT=1000
CHATGPT_EXPORT_INLINE_MAX_BYTES=524288
CHATGPT_EXPORT_TTL_SECONDS=900
CHATGPT_EXPORT_AUDIT_RETENTION_SECONDS=7776000
CHATGPT_EXPORT_MAX_SNAPSHOT_BYTES=67108864
CHATGPT_SESSION_TTL_SECONDS=7200
# Files are temporarily spooled to disk; tune limits independently from upstream ChatGPT limits.
# CHATGPT_FILE_STORE_DIR=
CHATGPT_FILE_STORE_MAX_FILE_BYTES=536870912
CHATGPT_FILE_STORE_MAX_TOTAL_BYTES=2147483648
CHATGPT_FILE_STORE_MAX_TRANSFERS=4
CHATGPT_FILE_STORE_MAX_CHUNK_BYTES=8388608
CHATGPT_FILE_STORE_IO_CHUNK_BYTES=262144
CHATGPT_FILE_STORE_TTL_SECONDS=7200
CHATGPT_FILE_STORE_METADATA_RETENTION_SECONDS=7776000
# Set only for the remote HTTP Broker; keep this out of source control.
# CHATGPT_ORACLE_BEARER_TOKEN=<user-level secret>

# Independent Gemini MCP/data; browser and four resident slots are shared.
GEMINI_ORACLE_TRANSPORT=stdio
GEMINI_ORACLE_HOST=127.0.0.1
GEMINI_ORACLE_PORT=8788
# Already signed-in Google account URL indices; the browser keeps all credentials.
GEMINI_ACCOUNT_INDEXES=0,1
# Optional fixed preference; otherwise manual URL changes / last verified account win.
# GEMINI_PREFERRED_ACCOUNT_INDEX=1
GEMINI_ORACLE_MCP_PATH=/mcp
GEMINI_BROWSER_CDP_URL=http://127.0.0.1:9333
# Legacy standalone profile defaults to ~/.agent-browser/gemini-native-profile.
# Shared mode uses the common ORACLE_* settings above; sign in manually.
# GEMINI_PROFILE_DIR=
GEMINI_BROWSER_LAUNCH_CDP=0
GEMINI_FILE_STORE_MAX_FILE_BYTES=104857600
GEMINI_CONSULT_POLL_SECONDS=2
GEMINI_CRITIC_POLL_SECONDS=2
GEMINI_RESEARCH_POLL_SECONDS=10
# GEMINI_ORACLE_BEARER_TOKEN=<separate-user-level-secret>
# GEMINI_ORACLE_ALLOWED_HOSTS=<exact-public-host>
# GEMINI_ORACLE_TAILSCALE_IPS=100.77.245.1
# GEMINI_ORACLE_PUBLIC_BASE_URL=<externally-reachable-origin>

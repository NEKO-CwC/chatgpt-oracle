CHATGPT_ORACLE_ROOT=D:\\Project\\NEKO\\gpt explorer
CHATGPT_ORACLE_TRANSPORT=stdio
CHATGPT_ORACLE_HOST=127.0.0.1
CHATGPT_ORACLE_PORT=8787
CHATGPT_ORACLE_MCP_PATH=/mcp
# Set the externally reachable origin when clients cannot resolve relative /v2 file paths.
# CHATGPT_ORACLE_PUBLIC_BASE_URL=https://chatgpt-oracle.frp-service.neko-dashboard.com:32751
# Exact Host values accepted by the MCP transport; comma-separated.
CHATGPT_ORACLE_ALLOWED_HOSTS=chatgpt-oracle.frp-service.neko-dashboard.com:32751
CHATGPT_BROWSER_CDP_URL=http://127.0.0.1:9222
CHATGPT_CHROME_EXECUTABLE=D:\\Program Files\\Google\\Chrome\\Application\\chrome.exe
CHATGPT_BROWSER_LAUNCH_CDP=1
# Maximum count for recent-turn exports; not a source API page limit.
CHATGPT_EXPORT_MAX_COUNT=1000
CHATGPT_EXPORT_INLINE_MAX_BYTES=524288
CHATGPT_EXPORT_TTL_SECONDS=900
CHATGPT_EXPORT_AUDIT_RETENTION_SECONDS=7776000
CHATGPT_EXPORT_MAX_SNAPSHOT_BYTES=67108864
CHATGPT_SESSION_TTL_SECONDS=7200
# Files are temporarily spooled to disk; tune limits independently from upstream ChatGPT limits.
# CHATGPT_FILE_STORE_DIR=
CHATGPT_FILE_STORE_MAX_FILE_BYTES=536870912
CHATGPT_FILE_STORE_MAX_TOTAL_BYTES=2147483648
CHATGPT_FILE_STORE_MAX_TRANSFERS=4
CHATGPT_FILE_STORE_MAX_CHUNK_BYTES=8388608
CHATGPT_FILE_STORE_IO_CHUNK_BYTES=262144
CHATGPT_FILE_STORE_TTL_SECONDS=7200
CHATGPT_FILE_STORE_METADATA_RETENTION_SECONDS=7776000
# Set only for the remote HTTP Broker; keep this out of source control.
# CHATGPT_ORACLE_BEARER_TOKEN=<user-level secret>
